---
import Layout from "@/layouts/Layout.astro";
import Products from "@/components/products.astro";
import { ProductCollection } from "@/libs/strapi";
import type { ProductData, ImageData } from "@/types/strapi";

interface Product extends ProductData {
  image: ImageData;
}

const [products, computers] = await Promise.all([
  ProductCollection
    .find({
      sort: "createdAt:desc",
      fields: ["name", "price", "slug"],
      populate: {
        image: {
          fields: ["caption", "width", "height", "url"],
        },
      },
      pagination: {
        pageSize: 8,
      },
    })
    .then(({ data }) => data as unknown as Product[])
    .catch((err) => {
      console.error(err);
      return null;
    }),
  ProductCollection
    .find({
      filters: {
        type: {
          name: {
            $eq: "Computers",
          },
        },
      },
      fields: ["name", "price", "slug"],
      populate: {
        image: {
          fields: ["caption", "width", "height", "url"],
        },
      },
      pagination: {
        pageSize: 4,
      },
    })
    .then(({ data }) => data as unknown as Product[])
    .catch((err) => {
      console.error(err);

      return null;
    }),
]);
---

<Layout title="Home">
  <div class="space-y-6">
    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Recent products</h2>
      {
        products && products.length > 0 ? (
          <Products products={products} />
        ) : (
          <span>Failed to fetch products</span>
        )
      }
    </section>
    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Computers</h2>
      {
        computers && computers.length > 0 ? (
          <Products products={computers} />
        ) : (
          <span>Failed to fetch products</span>
        )
      }
    </section>
  </div>
</Layout>
